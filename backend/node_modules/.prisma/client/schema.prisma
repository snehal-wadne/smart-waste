// Prisma schema for Waste Collection Management Platform
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  COLLECTED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String   @default("CITIZEN") // CITIZEN or ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WasteCategory {
  id                   String              @id @default(uuid())
  name                 String              @unique
  description          String
  icon                 String
  disposalInstructions String
  color                String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  requests             CollectionRequest[]
}

model CollectionRequest {
  id                String                 @id @default(uuid())
  requestNumber     String                 @unique
  trackingCode      String?
  userName          String
  userPhone         String
  userEmail         String?
  wasteCategoryId   String
  wasteCategory     WasteCategory          @relation(fields: [wasteCategoryId], references: [id])
  wasteDescription  String?
  pickupAddress     String
  city              String?                @default("Metro City")
  pincode           String?
  preferredDate     String
  preferredTime     String
  status            RequestStatus          @default(PENDING)
  notes             String?
  estimatedWeightKg Float?
  collectorName     String?
  dispatchNotes     String?
  statusHistory     RequestStatusHistory[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model RequestStatusHistory {
  id        String            @id @default(uuid())
  requestId String
  request   CollectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  oldStatus String?
  newStatus String
  changedAt DateTime          @default(now())
  note      String?
}
